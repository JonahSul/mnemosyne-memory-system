{
	"name": "mnemosyne-memory-system",
	"main": "src/index.ts",
	"compatibility_date": "2024-11-27",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": [
				"MnemosyneMemoryMCP"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MnemosyneMemoryMCP",
				"name": "MNEMOSYNE_MCP_OBJECT"
			}
		]
	},
	"define": {
		"__WRANGLER_ENV__": "\"development\""
	},
	"env": {
		"production": {
			"define": {
				"__WRANGLER_ENV__": "\"production\""
			}
		}
	},
	"observability": {
		"logs": {
			"enabled": true
		}
	}
}
