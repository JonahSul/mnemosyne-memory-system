{
	"name": "mnemosyne-memory-system",
	"version": "2.0.1-dev.0",
	"description": "Mnemosyne Memory System for AI behavior regulation and cognitive enhancement - DDD SaaS architecture",
	"main": "packages/mnemosyne-saas/src/worker.ts",
	"type": "module",
	"private": true,
	"workspaces": [
		"packages/mnemosyne-pubsub",
		"packages/mnemosyne-core",
		"packages/mnemosyne-infrastructure-cloudflare",
		"packages/mnemosyne-infrastructure-sqlite",
		"packages/mnemosyne-mcp-server",
		"packages/mnemosyne-streaming",
		"packages/mnemosyne-saas",
		"packages/mnemosyne-cli"
	],
	"scripts": {
		"dev": "wrangler dev -e staging",
		"deploy": "wrangler deploy -e staging",
		"build": "pnpm --filter @mnemosyne/core --filter @mnemosyne/infra-cloudflare --filter @mnemosyne/infra-sqlite --filter @mnemosyne/mcp-server --filter @mnemosyne/streaming --filter @mnemosyne/saas --filter @mnemosyne/cli --filter @mnemosyne/pubsub run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"docs:generate": "typedoc",
		"docs:serve": "pnpm docs:generate && npx serve docs/api"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.17.3",
		"jose": "^6.2.3",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20241127.0",
		"@types/node": "^24.3.0",
		"dotenv": "^17.2.1",
		"tsx": "^4.7.1",
		"typedoc": "^0.27.9",
		"typescript": "^5.3.3",
		"vitest": "^2.1.9",
		"wrangler": "^4.42.0"
	}
}
