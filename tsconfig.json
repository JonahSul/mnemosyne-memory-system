{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"allowJs": true,
		"checkJs": false,
		"declaration": true,
		"declarationMap": true,
		"skipLibCheck": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"isolatedModules": true,
		"types": [
			"@cloudflare/workers-types"
		],
		"resolveJsonModule": true,
		"downlevelIteration": true,
		"baseUrl": ".",
		"paths": {
			"@mnemosyne/core": [
				"packages/mnemosyne-core/src/index.ts"
			],
			"@mnemosyne/core/*": [
				"packages/mnemosyne-core/src/*"
			],
			"@mnemosyne/infra-cloudflare": [
				"packages/mnemosyne-infrastructure-cloudflare/src/index.ts"
			],
			"@mnemosyne/infra-cloudflare/*": [
				"packages/mnemosyne-infrastructure-cloudflare/src/*"
			],
			"@mnemosyne/infra-sqlite": [
				"packages/mnemosyne-infrastructure-sqlite/src/index.ts"
			],
			"@mnemosyne/infra-sqlite/*": [
				"packages/mnemosyne-infrastructure-sqlite/src/*"
			],
			"@mnemosyne/mcp-server": [
				"packages/mnemosyne-mcp-server/src/index.ts"
			],
			"@mnemosyne/mcp-server/*": [
				"packages/mnemosyne-mcp-server/src/*"
			],
			"@mnemosyne/streaming": [
				"packages/mnemosyne-streaming/src/index.ts"
			],
			"@mnemosyne/streaming/*": [
				"packages/mnemosyne-streaming/src/*"
			],
			"@mnemosyne/saas": [
				"packages/mnemosyne-saas/src/index.ts"
			],
			"@mnemosyne/saas/*": [
				"packages/mnemosyne-saas/src/*"
			],
			"@mnemosyne/cli": [
				"packages/mnemosyne-cli/src/index.ts"
			],
			"@mnemosyne/cli/*": [
				"packages/mnemosyne-cli/src/*"
			],
			"@mnemosyne/pubsub": [
				"packages/mnemosyne-pubsub/src/index.ts"
			],
			"@mnemosyne/pubsub/*": [
				"packages/mnemosyne-pubsub/src/*"
			]
		}
	},
	"include": [
		"packages/mnemosyne-core/src/**/*",
		"packages/mnemosyne-infrastructure-cloudflare/src/**/*",
		"packages/mnemosyne-infrastructure-sqlite/src/**/*",
		"packages/mnemosyne-mcp-server/src/**/*",
		"packages/mnemosyne-streaming/src/**/*",
		"packages/mnemosyne-saas/src/**/*",
		"packages/mnemosyne-cli/src/**/*",
		"packages/mnemosyne-pubsub/src/**/*",
		"tests/**/*"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}