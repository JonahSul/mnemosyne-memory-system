{
	"name": "mnemosyne-sqlite-vscode",
	"displayName": "Mnemosyne SQLite MCP Server",
	"description": "Project-local knowledge storage via MCP with SQLite backend",
	"version": "1.0.0",
	"publisher": "jonahsul",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Machine Learning",
		"Other"
	],
	"keywords": [
		"mcp",
		"model-context-protocol",
		"ai",
		"agent",
		"rag",
		"knowledge-base",
		"sqlite",
		"memory",
		"semantic-search"
	],
	"activationEvents": [],
	"main": "./extension.js",
	"contributes": {
		"configuration": {
			"title": "Mnemosyne SQLite",
			"properties": {
				"mnemosyne.sqlite.databasePath": {
					"type": "string",
					"default": "${workspaceFolder}/.mnemosyne/knowledge.db",
					"description": "Path to the SQLite database file for knowledge storage",
					"scope": "workspace"
				},
				"mnemosyne.sqlite.autoInstall": {
					"type": "boolean",
					"default": true,
					"description": "Automatically install the MCP server package if not present"
				}
			}
		},
		"commands": [
			{
				"command": "mnemosyne.sqlite.install",
				"title": "Install Mnemosyne SQLite MCP Server",
				"category": "Mnemosyne"
			},
			{
				"command": "mnemosyne.sqlite.configure",
				"title": "Configure MCP Server",
				"category": "Mnemosyne"
			},
			{
				"command": "mnemosyne.sqlite.showStats",
				"title": "Show Knowledge Base Statistics",
				"category": "Mnemosyne"
			}
		]
	},
	"scripts": {
		"package": "vsce package",
		"publish": "vsce publish"
	},
	"dependencies": {
		"@mnemosyne/sqlite": "workspace:^1.0.0"
	},
	"devDependencies": {
		"@types/vscode": "^1.80.0",
		"@vscode/vsce": "^2.22.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/JonahSul/mnemosyne-memory-system.git"
	},
	"bugs": {
		"url": "https://github.com/JonahSul/mnemosyne-memory-system/issues"
	},
	"license": "MIT"
}