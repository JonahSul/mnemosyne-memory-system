{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"ignoreDeprecations": "5.0",
		"paths": {
			"@mnemosyne-core/core": ["packages/mnemosyne/dist/library"],
			"@mnemosyne-core/core/*": ["packages/mnemosyne/dist/*"]
		},
		"composite": false,
		"declaration": true,
		"declarationMap": true
	},
	"include": ["src/**/*"],
	"exclude": ["dist", "node_modules"]
}
