{
	"name": "@mnemosyne/streaming",
	"version": "2.0.1-dev.1",
	"description": "Real SSE and WebSocket streaming for Mnemosyne — domain events pushed to connected clients. No fake SSE.",
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/JonahSul/mnemosyne-memory-system.git",
		"directory": "packages/mnemosyne-streaming"
	},
	"bugs": {
		"url": "https://github.com/JonahSul/mnemosyne-memory-system/issues"
	},
	"homepage": "https://github.com/JonahSul/mnemosyne-memory-system/tree/main/packages/mnemosyne-streaming",
	"author": "Jonah Sul",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./adapters/cloudflare": {
			"import": "./dist/adapters/cloudflare.js",
			"types": "./dist/adapters/cloudflare.d.ts"
		},
		"./adapters/express": {
			"import": "./dist/adapters/express.js",
			"types": "./dist/adapters/express.d.ts"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@mnemosyne/core": "workspace:*",
		"@mnemosyne/pubsub": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.3.3"
	},
	"sideEffects": false
}
