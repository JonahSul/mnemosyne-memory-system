{
	"name": "@mnemosyne/core",
	"version": "1.0.0",
	"description": "Core Mnemosyne memory system modules and utilities.",
	"type": "module",
	"main": "dist/library.js",
	"module": "dist/library.js",
	"types": "dist/library.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/JonahSul/mnemosyne-memory-system.git",
		"directory": "packages/mnemosyne"
	},
	"bugs": {
		"url": "https://github.com/JonahSul/mnemosyne-memory-system/issues"
	},
	"homepage": "https://github.com/JonahSul/mnemosyne-memory-system/tree/main/packages/mnemosyne",
	"author": "Jonah Sul",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"exports": {
		".": {
			"import": "./dist/library.js",
			"types": "./dist/library.d.ts"
		},
		"./*": {
			"import": "./dist/*.js",
			"types": "./dist/*.d.ts"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json"
	},
	"sideEffects": false
}